+/*
+ * 不拿 BQL 读 PMCCNTR,给 hvf 的快路径用。
+ *
+ * Windows on Arm 每次线程切换、每个中断都读周期计数器,实测每秒 50 万次以上。
+ * hvf 下这些读全部陷入 QEMU,原路径要先抢 BQL,4 个 vCPU 光排队就耗掉两成多时间。
+ *
+ * 结果与原路径 pmu_op_start + 读 c15_ccnt + pmu_op_finish 相同,但不改任何状态:
+ * 计数器开着时是(按需 64 分频后的)时钟减 c15_ccnt_delta,关着时就是 c15_ccnt。
+ * 溢出由上一次慢路径排好的 pmu_timer 负责,读不读都不影响。
+ * 这些字段只有本 vCPU 线程会改(PMU 寄存器的写走慢路径,也在本线程),所以不需要锁。
+ *
+ * 前提是「开没开」不会在两次写 PMU 寄存器之间自己变:没有 EL2/EL3,
+ * 且 PMCCFILTR 对 EL0 和 EL1 的过滤一致(P == U)。不满足就返回 false,调用方退回原路径。
+ */
+bool pmccntr_read_nolock(CPUARMState *env, uint64_t *val)
+{
+    uint64_t filter = env->cp15.pmccfiltr_el0;
+
+    if (!arm_feature(env, ARM_FEATURE_PMU) ||
+        arm_feature(env, ARM_FEATURE_EL2) ||
+        arm_feature(env, ARM_FEATURE_EL3) ||
+        !(filter & PMXEVTYPER_P) != !(filter & PMXEVTYPER_U)) {
+        return false;
     }
+    if (pmu_counter_enabled(env, 31)) {
+        uint64_t eff_cycles = cycles_get_count(env);
+        if (pmccntr_clockdiv_enabled(env)) {
+            eff_cycles /= 64;
+        }
+        *val = eff_cycles - env->cp15.c15_ccnt_delta;
+    } else {
+        *val = env->cp15.c15_ccnt;
+    }
+    return true;
 }
 
