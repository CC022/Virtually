+/*
+ * 不拿 BQL 就能处理完的退出。目前只有读 PMCCNTR_EL0。
+ *
+ * Windows on Arm 每次线程切换、每个中断都读周期计数器。同花顺这类负载下实测每秒 50 万次以上,
+ * 占全部退出的七成多;原路径每次都要抢 BQL,4 个 vCPU 光排队就耗掉两成多时间。
+ * 读不出结果也不能让它不陷入:Hypervisor.framework 不直通 PMU,而 -cpu pmu=off 时
+ * Windows 启动管理器照样读 PMU 寄存器、吃到 UNDEF 就崩。见 docs/PERFORMANCE.md。
+ *
+ * 处理完返回 true,调用方不拿锁直接再进 guest。别的都返回 false 走原路径,包括:
+ * 被踢(暂停、run_on_cpu、中断线变化都靠踢)、vtimer 事件、单步调试、
+ * vtimer 已屏蔽等着同步,以及 pmccntr_read_nolock 不支持的计数器配置。
+ */
+static bool hvf_fast_exit(CPUState *cpu)
+{
+    hv_vcpu_exit_t *e = cpu->accel->exit;
+    uint64_t syndrome = e->exception.syndrome;
+    uint64_t val, pc;
+    uint32_t rt;
+
+    if (e->reason != HV_EXIT_REASON_EXCEPTION ||
+        syn_get_ec(syndrome) != EC_SYSTEMREGISTERTRAP ||
+        !(syndrome & 1) ||
+        (syndrome & SYSREG_MASK) != SYSREG_PMCCNTR_EL0 ||
+        cpu->singlestep_enabled || cpu->accel->vtimer_masked) {
+        return false;
+    }
+    if (!pmccntr_read_nolock(&ARM_CPU(cpu)->env, &val)) {
+        return false;
+    }
+
+    rt = (syndrome >> 5) & 0x1f;
+    if (rt < 31) {
+        assert_hvf_ok(hv_vcpu_set_reg(cpu->accel->fd, HV_REG_X0 + rt, val));
+    }
+    assert_hvf_ok(hv_vcpu_get_reg(cpu->accel->fd, HV_REG_PC, &pc));
+    assert_hvf_ok(hv_vcpu_set_reg(cpu->accel->fd, HV_REG_PC, pc + 4));
+
+    /* 原路径每次进 guest 前都按 interrupt_request 重新挂一次中断,这里照做 */
+    hvf_inject_interrupts(cpu);
+    return true;
+}
