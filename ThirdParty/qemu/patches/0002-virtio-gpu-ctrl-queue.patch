--- a/hw/display/virtio-gpu-base.c	2026-08-27 05:23:31
+++ b/hw/display/virtio-gpu-base.c	2026-09-13 22:57:55
@@ -241,7 +241,13 @@
         virtio_add_queue(vdev, 256, ctrl_cb);
         virtio_add_queue(vdev, 16, cursor_cb);
     } else {
-        virtio_add_queue(vdev, 64, ctrl_cb);
+        /*
+         * 2D 模式原本是 64。Windows 的 viogpudo 给帧缓冲挂内存(RESOURCE_ATTACH_BACKING)时
