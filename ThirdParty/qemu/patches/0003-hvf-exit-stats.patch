+/*
+ * 退出统计(环境变量 VIRTUALLY_HVF_STATS=1 开启):每秒往 stderr(即 QEMU 日志)打一行,
+ * 按类别列出每秒退出次数,以及 vCPU 时间分给了「跑 guest / 等 BQL / WFI 停机 / 其余」各多少。
+ * 采样器看不出哪类退出贵,这个能:QEMU 10.0 用户态 GIC 时 Windows 每秒 50 万次以上读 PMCCNTR、
+ * 5 万次 IPI 就是靠它看出来的。开 kernel-irqchip 后应只剩 MMIO。
+ *
+ * 计数都在 BQL 下改。不开的时候每次退出只多一次分支。
+ */
+typedef struct HVFStats {
+    uint64_t exits, vtimer, kick, mmio, psci, wfe, other;
+    uint64_t wfi_halt, wfi_nohalt;
+    uint64_t icc_iar, icc_eoi, icc_dir, icc_sgi, icc_other, pmu, sysreg_other;
+    uint64_t ns_guest, ns_bql, ns_halt;
+    uint32_t other_reg;
+    uint64_t last;
+} HVFStats;
+static HVFStats hvf_stats;
+static int hvf_stats_on = -1;
+/* 本 vCPU 线程上一次因 WFI 停机的时刻,回到 hvf_arch_vcpu_exec 时结算 */
+static __thread uint64_t hvf_stats_halt_since;
+
+#define HVF_STAT(field) do {                    \
+        if (unlikely(hvf_stats_on > 0)) {       \
+            hvf_stats.field++;                  \
+        }                                       \
+    } while (0)
+
+static inline bool hvf_stats_enabled(void)
+{
+    if (unlikely(hvf_stats_on < 0)) {
+        hvf_stats_on = getenv("VIRTUALLY_HVF_STATS") != NULL;
+    }
+    return hvf_stats_on > 0;
+}
+
+static inline uint64_t hvf_stats_now(void)
+{
+    return clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+static void hvf_stats_tick(uint64_t now)
+{
+    HVFStats *s = &hvf_stats;
+    CPUState *c;
+    int n = 0;
+    uint64_t dt;
+    double per, pct;
+
+    if (!s->last) {
+        s->last = now;
+        return;
+    }
+    dt = now - s->last;
+    if (dt < NANOSECONDS_PER_SECOND) {
+        return;
+    }
+    CPU_FOREACH(c) {
+        n++;
+    }
+    per = (double)NANOSECONDS_PER_SECOND / dt;
+    pct = 100.0 / ((double)dt * n);
+    fprintf(stderr,
+            "[hvf] exits=%.0f vtimer=%.0f kick=%.0f wfi(halt=%.0f nohalt=%.0f) "
+            "wfe=%.0f icc(iar=%.0f eoi=%.0f dir=%.0f sgi=%.0f other=%.0f) pmu=%.0f "
+            "sysreg=%.0f(last 0x%08x) mmio=%.0f psci=%.0f other=%.0f | "
+            "guest=%.1f%% bql=%.1f%% halt=%.1f%% rest=%.1f%%\n",
+            s->exits * per, s->vtimer * per, s->kick * per,
+            s->wfi_halt * per, s->wfi_nohalt * per, s->wfe * per,
+            s->icc_iar * per, s->icc_eoi * per, s->icc_dir * per,
+            s->icc_sgi * per, s->icc_other * per, s->pmu * per,
+            s->sysreg_other * per, s->other_reg, s->mmio * per, s->psci * per,
+            s->other * per,
+            s->ns_guest * pct, s->ns_bql * pct, s->ns_halt * pct,
+            100.0 - (s->ns_guest + s->ns_bql + s->ns_halt) * pct);
+    memset(s, 0, sizeof(*s));
+    s->last = now;
 }
 
+static void hvf_stats_sysreg(uint32_t reg)
+{
+    if (reg == SYSREG_ICC_IAR1_EL1 || reg == SYSREG_ICC_IAR0_EL1) {
+        hvf_stats.icc_iar++;
+    } else if (reg == SYSREG_ICC_EOIR1_EL1 || reg == SYSREG_ICC_EOIR0_EL1) {
+        hvf_stats.icc_eoi++;
+    } else if (reg == SYSREG_ICC_DIR_EL1) {
+        hvf_stats.icc_dir++;
+    } else if (reg == SYSREG_ICC_SGI1R_EL1 || reg == SYSREG_ICC_SGI0R_EL1 ||
+               reg == SYSREG_ICC_ASGI1R_EL1) {
+        hvf_stats.icc_sgi++;
+    } else if (SYSREG_OP0(reg) == 3 && SYSREG_OP1(reg) == 0 &&
+               (SYSREG_CRN(reg) == 12 ||
+                (SYSREG_CRN(reg) == 4 && SYSREG_CRM(reg) == 6))) {
+        hvf_stats.icc_other++;
+    } else if (SYSREG_OP0(reg) == 3 && SYSREG_OP1(reg) == 3 &&
+               SYSREG_CRN(reg) == 9) {
+        hvf_stats.pmu++;
+    } else {
+        hvf_stats.sysreg_other++;
+        hvf_stats.other_reg = reg;
+    }
+}
